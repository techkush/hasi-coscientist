# HASI dashboard env vars.
#
# You normally do NOT need a .env.local — hasi-run.sh exports these at boot.
# Copy this file to .env.local only if you run `npx tsx server.ts` directly.

# Where the Python conductor server is listening.
CONDUCTOR_URL=http://127.0.0.1:8780

# Path to the workspace's projects/ folder (each research project lives here).
WORKSPACE_ROOT=${HOME}/.openclaw/workspace/projects

# Where the UI mirror of projects.json lives. Created on first run.
HASI_DATABASE_DIR=${HOME}/.openclaw/workspace/database

# Port for the Next.js custom server (Next + WebSocket in one process).
PORT=3000
