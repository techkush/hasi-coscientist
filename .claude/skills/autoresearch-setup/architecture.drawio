        </mxCell>
        <mxCell id="io_out" value="Run artifacts (written by prepare_run.py)&#10;&#10;• git repo + baseline commit (explicit paths only)&#10;• tag  ar-baseline  (every run forks from it)&#10;• branch  autoresearch/&lt;tag&gt;&#10;• .gitignore — data ignored, spec.md TRACKED&#10;• results.tsv — header = spec columns" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="730" y="360" width="310" height="120" as="geometry" />
