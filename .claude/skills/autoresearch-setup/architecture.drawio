        <mxCell id="e_gate_val" value="calls" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c_gate" target="io_validate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_mat_out" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c_mat" target="io_out"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===================== CONTROL FLOW ===================== -->
        <mxCell id="flow_title" value="Control flow" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1">
