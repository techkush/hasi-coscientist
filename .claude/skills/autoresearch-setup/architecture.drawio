          <mxGeometry x="40" y="555" width="320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="Step 2 — readiness.py (PRE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="625" width="320" height="45" as="geometry" />
