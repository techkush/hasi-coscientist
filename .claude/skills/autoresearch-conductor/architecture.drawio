<mxfile host="app.diagrams.net" agent="autoresearch-conductor" version="24.0.0">
  <diagram name="autoresearch-conductor architecture" id="ar-conductor-arch">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="autoresearch-conductor — master dashboard that drives the whole pipeline (one UI, gated stages)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="30" as="geometry" />
        </mxCell>

        <!-- BROWSER -->
        <mxCell id="browser" value="Browser dashboard (shadcn theme)&#10;projects grid  ·  pipeline view (gated stage sidebar)  ·  loop Start/Stop  ·  results + report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="700" height="56" as="geometry" />
        </mxCell>

        <!-- SERVER + LIB + AGENT -->
        <mxCell id="arch_bg" value="Conductor core" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="700" height="250" as="geometry" />
        </mxCell>
        <mxCell id="server" value="conductor_server.py — file bus&#10;/api/projects · /api/project · /api/results · /api/report&#10;POST /api/new · /api/run{slug,stage} · /api/stop  (gating enforced)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="65" y="185" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lib" value="conductor_lib.py&#10;scan projects · compute stage status&#10;+ enable-gating · results summary&#10;conductor.json IO · loop lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="490" y="185" width="225" height="80" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="SKILL.md — the agent (orchestrator)&#10;monitors control files → runs the matching stage → updates state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="65" y="295" width="650" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bus" value="control files: new_project.json · run_request.json · stop.json · state.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="65" y="355" width="650" height="34" as="geometry" />
        </mxCell>
        <mxCell id="e_br_sv" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="browser" target="server"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_sv_lib" value="imports" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;fontSize=10;" edge="1" parent="1" source="server" target="lib"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_sv_bus" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="server" target="bus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ag_bus" value="reads/writes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;fontSize=10;" edge="1" parent="1" source="agent" target="bus"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- STATE -->
        <mxCell id="state_bg" value="Per-project state (the workspace)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="150" width="370" height="250" as="geometry" />
        </mxCell>
        <mxCell id="st_json" value="&lt;slug&gt;/.autoresearch/conductor.json&#10;name · description · created · run_tag" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="788" y="182" width="334" height="44" as="geometry" />
        </mxCell>
        <mxCell id="st_spec" value="spec.md · run.py/prepare.py · results.tsv · idea.md · findings.md · report.pdf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="788" y="236" width="334" height="44" as="geometry" />
        </mxCell>
        <mxCell id="st_lock" value="🔒 .autoresearch/loop.lock&#10;present while the loop runs → locks every other stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="788" y="290" width="334" height="44" as="geometry" />
        </mxCell>
        <mxCell id="st_note" value="stage status derived LIVE from the filesystem (never cached)" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="344" width="334" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e_lib_state" value="reads" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1" source="lib" target="st_spec"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- GATED PIPELINE -->
        <mxCell id="pl_title" value="Gated pipeline — each stage runs the sub-skill's controlled scripts; a stage unlocks only when the previous is done" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1100" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s_init" value="init&#10;write spec.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="150" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s_gen" value="generate&#10;scaffold.py + validate.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="225" y="470" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s_setup" value="setup&#10;prepare_run.py + readiness.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="470" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s_ideas" value="ideas (optional)&#10;basket.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="645" y="470" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s_loop" value="loop&#10;run_iter.py (locks others)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="470" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s_an" value="analyze&#10;report.py → report.pdf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1055" y="470" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="spec.md" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="s_init" target="s_gen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" value="run.py" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="s_gen" target="s_setup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3" value="branch+baseline" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="s_setup" target="s_ideas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4" value="idea.md (or skip)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="s_ideas" target="s_loop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3b" value="(ideas optional)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_setup" target="s_loop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g5" value="≥1 keep" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="s_loop" target="s_an"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- agent runs stages -->
        <mxCell id="e_ag_pl" value="runs the enabled stage" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="agent" target="s_setup"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- GUARANTEES -->
        <mxCell id="g_box" value="How it behaves" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="540" height="300" as="geometry" />
        </mxCell>
        <mxCell id="g_list" value="1. One dashboard drives the whole pipeline; the per-skill panels&#10;    are not needed.&#10;&#10;2. Enable-gating: a stage unlocks only when its prerequisite is&#10;    done (init→generate→setup→loop→analyze). Ideas is optional —&#10;    no idea.md means the loop uses its own ideas.&#10;&#10;3. While the loop runs, every other stage is locked; the UI offers&#10;    Stop. The loop checks stop.json each iteration.&#10;&#10;4. Status is derived LIVE from the filesystem (spec.md present?&#10;    run.py filled? on autoresearch branch + ar-baseline tag?&#10;    results.tsv keeps? report.pdf?) — never stale.&#10;&#10;5. Each stage delegates to the other skills' controlled scripts —&#10;    no mechanics re-implemented here.&#10;&#10;6. Per-project metadata in .autoresearch/conductor.json;&#10;    new projects are created from a single idea (init)." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="588" width="524" height="264" as="geometry" />
        </mxCell>

        <!-- pipeline lane mapping note -->
        <mxCell id="map_box" value="Drives the sibling skills' scripts" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#eef6ff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="560" width="540" height="300" as="geometry" />
        </mxCell>
        <mxCell id="map_list" value="init     →  write spec.md (init template + inference)&#10;generate →  autoresearch-generate/scaffold.py + validate.py&#10;setup    →  autoresearch-setup/prepare_run.py + readiness.py&#10;ideas    →  autoresearch-ideas/basket.py  (init / add / status)&#10;loop     →  autoresearch-loop/run_iter.py  (baseline + iterate)&#10;analyze  →  autoresearch-analyze/report.py  (summary + PDF)&#10;&#10;The conductor never bypasses these — it is the front-of-house;&#10;they remain the controlled, tested back-of-house." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=11;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="608" y="590" width="524" height="262" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
