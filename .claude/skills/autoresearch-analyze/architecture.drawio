        </mxCell>
        <mxCell id="pdf_plot" value="▥ Plot — metric (Y) vs experiment # (X)&#10;one plot per improved metric&#10;kept points · running best · baseline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="466" y="672" width="268" height="78" as="geometry" />
        </mxCell>
        <mxCell id="pdf_list" value="Kept experiments (status = keep)&#10;#exp · commit · value (Δ)&#10;[provenance badge] · description&#10;Human / Web·paper / Idea basket / AI agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eafaf0;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="466" y="758" width="268" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== GUARANTEES ===================== -->
        <mxCell id="g_box" value="Guarantees — fixed vs. the old prose-only analyze" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="775" y="540" width="300" height="345" as="geometry" />
        </mxCell>
        <mxCell id="g_list" value="1. Charts EVERY numeric metric (primary +&#10;    secondaries), not just the primary.&#10;&#10;2. Percent improvement guarded against a&#10;    zero baseline (no inf / nan).&#10;&#10;3. Provenance is classified for every kept&#10;    run — keeps missing from findings.md&#10;    default to “AI agent”, never blank.&#10;&#10;4. Direction-aware everywhere (best = min&#10;    or max by spec direction).&#10;&#10;5. Crashes excluded from baseline/best/&#10;    plots; counted in the summary.&#10;&#10;6. Read-only: never edits ledger / files /&#10;    git. Stats are computed once, not by&#10;    hand.&#10;&#10;7. Degrades cleanly with no matplotlib&#10;    (text summary still prints).&#10;&#10;8. Single-page pageless PDF with a fixed&#10;    template + agent-written narratives." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="783" y="568" width="288" height="310" as="geometry" />
        </mxCell>

      </root>
