        <!-- ===================== PDF TEMPLATE MOCK ===================== -->
        <mxCell id="pdf_bg" value="report.pdf — single-page (pageless) template" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;align=center;spacingTop=8;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
