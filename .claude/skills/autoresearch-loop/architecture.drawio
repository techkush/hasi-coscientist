          <mxGeometry x="730" y="200" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="io_run" value="runner_command → run.log&#10;(per run, untracked; subprocess timeout)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="730" y="262" width="310" height="48" as="geometry" />
        </mxCell>
        <mxCell id="io_ledger" value="results.tsv — UNTRACKED (survives reset --hard)&#10;findings.md — provenance of new bests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="730" y="322" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="io_git" value="git: commit edit · reset --hard START&#10;rewind floor = ar-baseline tag (never below)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="730" y="384" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_spec_sk" value="read" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1" source="io_spec" target="c_skill"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_eng_run" value="runs" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c_eng" target="io_run"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_eng_led" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c_eng" target="io_ledger"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_eng_git" value="git" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c_eng" target="io_git"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===================== ITERATION CYCLE ===================== -->
        <mxCell id="flow_title" value="One iteration (run_iter.py is atomic — the agent only picks &amp; edits)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ag" value="AGENT (judgment)&#10;pick one idea · EDIT editable file · DO NOT commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="545" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="① capture START = HEAD  (edit still uncommitted ⇒ true pre-experiment commit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="615" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="② commit editable by explicit path   (skipped for --baseline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="668" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="③ run within hard-kill budget  (Python subprocess timeout → run.log)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="721" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="④ read measure: LAST match, prefer the final --- block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="774" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d" value="⑤ clean run &amp; strictly better?&#10;(exit 0, in budget, finite, direction-aware)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="90" y="832" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="keep" value="KEEP&#10;leave HEAD on the new commit&#10;(or --keep-anyway for a simplification)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="815" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="revert" value="DISCARD / CRASH&#10;git reset --hard START&#10;(ledger · log · basket survive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="430" y="885" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="log" value="⑥ append row → results.tsv (untracked, sanitized)&#10;+ findings.md line on a new best (--source)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="90" y="965" width="350" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cont" value="⑦ continue — NEVER STOP&#10;(crash? trivial fix → fresh iteration; else next idea)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1035" width="350" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ee1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ag" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s4" target="d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed_y" value="yes → keep" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="d" target="keep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed_n" value="no / crash → revert" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="d" target="revert"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ek_l" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="keep" target="log"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er_l" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="revert" target="log"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_c" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="log" target="cont"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="loopback" value="next idea (loop)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;dashed=1;strokeColor=#6c8ebf;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cont" target="ag"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="1060" /><mxPoint x="20" y="570" /></Array></mxGeometry></mxCell>

        <!-- ===================== GUARANTEES ===================== -->
        <mxCell id="g_box" value="Guarantees — issues fixed vs. the old prose-only loop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="540" width="420" height="350" as="geometry" />
        </mxCell>
        <mxCell id="g_list" value="1. Final-measure read: takes the LAST match, preferring the&#10;    block after ---  (old grep took the first/intermediate line —&#10;    broke per-epoch training logs).&#10;&#10;2. Correct revert target: START = HEAD captured BEFORE the&#10;    commit; discard/crash reset to START (old HEAD~1 left a&#10;    change half-applied after a fix-and-re-run).&#10;&#10;3. Ledger safety: engine + preflight refuse if results.tsv is&#10;    TRACKED (a reset --hard would wipe logged rows).&#10;&#10;4. Portable budget: Python subprocess timeout, not shell&#10;    `timeout` (absent on macOS).&#10;&#10;5. Crash = exit≠0 OR timeout OR no/non-finite measure&#10;    (not just empty grep).&#10;&#10;6. Decision is numeric &amp; direction-aware over keep rows;&#10;    nan/inf counts as non-improvement.&#10;&#10;7. Edit-don't-commit contract enforced — the engine commits,&#10;    decides, reverts; you never hand-run git.&#10;&#10;8. Rewind floor = ar-baseline; ledger/log/idea basket stay&#10;    untracked and survive reverts.&#10;&#10;9. TSV-safe: description sanitized; findings.md auto-headered." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="728" y="568" width="404" height="315" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
