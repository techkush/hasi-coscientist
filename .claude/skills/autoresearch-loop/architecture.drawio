        <!-- ===================== I/O CONTRACT ===================== -->
        <mxCell id="io_bg" value="Reads / runs / writes" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
