# Docker mode env — copy to .env and fill in.
# Used by docker-compose.yml and docker-compose.extra.yml.

# Image to pull. Pin a tag for reproducibility, or use :latest.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# A random token used by the gateway for local auth. Generate with:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Bind mode: "lan" (default, accessible from LAN), "loopback" (127.0.0.1 only),
# or "all" (0.0.0.0). Use "loopback" for single-user dev.
OPENCLAW_GATEWAY_BIND=loopback

# Optional: if you don't have Claude auth in the host Keychain, set an Anthropic
# key here so the container can call the API directly. Leave blank if you'll
# rely on the macOS Keychain via the native CLI.
# ANTHROPIC_API_KEY=

# Optional: OpenRouter alternative (cheaper / faster than Anthropic for some workloads).
# OPENROUTER_API_KEY=

# Timezone for the container (so log timestamps match yours).
OPENCLAW_TZ=UTC
